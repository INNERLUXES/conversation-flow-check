{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "conversation-flow-check",
          "version": "1.0.0",
          "informationUri": "https://github.com/INNERLUXES/conversation-flow-check",
          "rules": [
            {
              "id": "file-unreadable",
              "name": "file-unreadable",
              "shortDescription": {
                "text": "a file is not a flow the reader can follow (a syntax error in the YAML subset or the JSON, a top level that is not a mapping, no start, no steps, or a file past a limit) or the widget file cannot be read as HTML text; no other check ran on that file"
              },
              "help": {
                "text": "Fix the line and column named; docs/inputs.md lists the YAML subset and the keys of a flow. (file)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "file"
              }
            },
            {
              "id": "field-invalid",
              "name": "field-invalid",
              "shortDescription": {
                "text": "a value is not what the format says: a step type that is not one of message, input, choice, confirm, action, handover or end; a channel that is not chat or voice; a reprompt_limit that is not a whole number from 0 to 99; a true or false value that is text; a prompt that is not text"
              },
              "help": {
                "text": "Write the value as docs/inputs.md says. The value is ignored until you do, so a check that needs it may report a second finding. (step)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "step"
              }
            },
            {
              "id": "field-unknown",
              "name": "field-unknown",
              "shortDescription": {
                "text": "a key the tool does not read, at the top level, in a step or in an option, often a misspelt name such as fallbak; nothing under it is checked"
              },
              "help": {
                "text": "Correct the name to a key of docs/inputs.md, or take the key out of the file. (file)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "file"
              }
            },
            {
              "id": "start-unknown",
              "name": "start-unknown",
              "shortDescription": {
                "text": "the start of the flow names a step that is not under steps (or names none); the checks of what can be reached did not run"
              },
              "help": {
                "text": "Set \"start\" to the id of the step where the conversation begins, spelt as under \"steps\". (flow)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "flow"
              }
            },
            {
              "id": "step-target-unknown",
              "name": "step-target-unknown",
              "shortDescription": {
                "text": "a next, yes, no, fallback, on_error or option names a step that is not under steps"
              },
              "help": {
                "text": "Correct the id, or add the step. A user who follows the edge reaches a step that does not exist. (step)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "step"
              }
            },
            {
              "id": "edge-missing",
              "name": "edge-missing",
              "shortDescription": {
                "text": "an option without a next step, or a confirm step that has only one of yes and no"
              },
              "help": {
                "text": "Give every option a next, and give a confirm step both a yes and a no. (step)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "step"
              }
            },
            {
              "id": "step-unreachable",
              "name": "step-unreachable",
              "shortDescription": {
                "text": "a step that cannot be reached from the start step by following next, yes, no, fallback, on_error and the options"
              },
              "help": {
                "text": "Link the step from a step that is reachable, or take it out of the file. A step nobody can reach is dead text that still has to be kept up to date. (flow)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "flow"
              }
            },
            {
              "id": "step-dead-end",
              "name": "step-dead-end",
              "shortDescription": {
                "text": "a step with no way out (no next, yes, no, fallback, on_error or option) that is not marked as an end, by the type end or handover or by end: true"
              },
              "help": {
                "text": "Add the step that follows it, or mark it as an end on purpose with type: end, type: handover or end: true. (step)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "step"
              }
            },
            {
              "id": "flow-trap",
              "name": "flow-trap",
              "shortDescription": {
                "text": "a reachable step from which no end, no handover and no dead end can be reached: a loop with no way out"
              },
              "help": {
                "text": "Give one step of the loop an edge that leaves it, such as a fallback to a handover after the reprompt limit. (flow)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "flow"
              }
            },
            {
              "id": "input-no-fallback",
              "name": "input-no-fallback",
              "shortDescription": {
                "text": "an input, choice or confirm step with no fallback: nothing says what happens when the answer does not match"
              },
              "help": {
                "text": "Add a fallback: the id of the step that handles an answer the step did not understand (a reprompt step, or a handover). (step)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "step"
              }
            },
            {
              "id": "input-no-reprompt-limit",
              "name": "input-no-reprompt-limit",
              "shortDescription": {
                "text": "an input, choice or confirm step with no reprompt_limit: nothing says how many times the user is asked again before the flow gives up and moves on"
              },
              "help": {
                "text": "Set reprompt_limit to the number of times the step asks again (often 2 or 3) before it follows its fallback. (step)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "step"
              }
            },
            {
              "id": "reprompt-limit-high",
              "name": "reprompt-limit-high",
              "shortDescription": {
                "text": "a reprompt_limit above --max-reprompts (default 3)"
              },
              "help": {
                "text": "Lower the limit, or raise --max-reprompts if the step is meant to ask that often. (step)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "step"
              }
            },
            {
              "id": "no-handover",
              "name": "no-handover",
              "shortDescription": {
                "text": "the flow has steps that wait for the user and no step of type handover, so there is no way to a person (--handover every-input or any)"
              },
              "help": {
                "text": "Add a step of type handover that passes the user to a human agent, and link it from the steps that wait for the user. Turn the check off with --handover off if the bot has no human to pass to. (flow)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "flow"
              }
            },
            {
              "id": "handover-unreachable",
              "name": "handover-unreachable",
              "shortDescription": {
                "text": "a reachable input, choice or confirm step from which no step of type handover can be reached (--handover every-input, the default)"
              },
              "help": {
                "text": "Add an edge from the step, or from its fallback, that leads to a handover step, so that a user can ask for a person from where they are stuck. (flow)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "flow"
              }
            },
            {
              "id": "voice-multiple-questions",
              "name": "voice-multiple-questions",
              "shortDescription": {
                "text": "in the voice channel, a prompt with more than one question mark"
              },
              "help": {
                "text": "Ask one question in each prompt and put the next question in the next step. A caller cannot scroll back to the first question. (wording)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "wording"
              }
            },
            {
              "id": "voice-prompt-too-long",
              "name": "voice-prompt-too-long",
              "shortDescription": {
                "text": "in the voice channel, a prompt with more than --max-words words (default 30)"
              },
              "help": {
                "text": "Shorten the prompt, or split it into two steps. Put the question at the end, and the choices last. (wording)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "wording"
              }
            },
            {
              "id": "irreversible-unconfirmed",
              "name": "irreversible-unconfirmed",
              "shortDescription": {
                "text": "a step marked irreversible: true, or an action step whose action (or id) holds a word such as pay, book, cancel, delete or refund, that can be reached without passing a confirm step whose yes leads to it"
              },
              "help": {
                "text": "Put a step of type confirm in front of the action, say what is about to happen in its text, and send its yes to the action. Every edge into the action must be the yes of a confirm step. (flow)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "flow"
              }
            },
            {
              "id": "ai-disclosure-missing",
              "name": "ai-disclosure-missing",
              "shortDescription": {
                "text": "the opening of the flow (the start step, and the message steps that follow it up to the first step that waits for the user) does not say that the user is talking to an automated system or to an AI, by none of the phrases set with --disclosure-phrases"
              },
              "help": {
                "text": "Say it in the first message, in plain words, such as \"I am an automated assistant\". Article 50 of the EU AI Act asks that people are told when they interact with an AI system, unless that is obvious from the circumstances. Turn the check off with --disable ai-disclosure-missing if it does not apply. (wording)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "wording"
              }
            },
            {
              "id": "widget-message-list-not-found",
              "name": "widget-message-list-not-found",
              "shortDescription": {
                "text": "in the widget HTML (--widget), no element looks like the list of messages (an id or class with messages, transcript, conversation, log or thread)"
              },
              "help": {
                "text": "Give the element that holds the messages an id or class that says so, with role=\"log\" or an aria-live attribute, so that the check and a reader of the page can find it. (widget)"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "kind": "widget"
              }
            },
            {
              "id": "widget-live-region-missing",
              "name": "widget-live-region-missing",
              "shortDescription": {
                "text": "in the widget HTML (--widget), the element that looks like the list of messages carries neither role=\"log\" (or status, or alert) nor aria-live=\"polite\" or \"assertive\"; WCAG 2.2 success criterion 4.1.3 (Status Messages) asks that a status message can be announced without taking the focus"
              },
              "help": {
                "text": "Add role=\"log\" to the element that holds the messages (it implies a polite live region), or aria-live=\"polite\". Do not set aria-live=\"off\". (widget)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "kind": "widget"
              }
            }
          ]
        }
      },
      "artifacts": [
        {
          "location": {
            "uri": "examples/good/booking-chat.yaml"
          }
        },
        {
          "location": {
            "uri": "examples/good/widget.html"
          }
        }
      ],
      "results": [],
      "properties": {
        "notice": "This report reads the flow file and nothing else. It does not run the flow and does not talk to a bot. A clean result means that none of the problems of its checks were found in the file; it is not a statement that the bot is good, accessible or lawful.",
        "result": "PASS - no finding at or above error"
      }
    }
  ]
}
